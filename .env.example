# Copy to .env.local for `vercel dev`; set the real values in Vercel → Settings → Environment Variables.
# Never commit real values.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# Cloudflare Turnstile (spam protection on the booking form).
# The site key is public and is baked into the page at build time.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
