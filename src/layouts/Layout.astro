---
// Shared page shell: <head> (per-page SEO), header, footer and the toast region.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toaster from '../components/Toaster.astro';

export const DEFAULT_TITLE = 'Stefan Borup | Fotograf i Lillestrøm';
export const DEFAULT_DESCRIPTION = 'Stefan Borup er en erfaren fotograf med base i Lillestrøm. Spesialiserer seg på portretter, produktbilder og arkitekturfotografi.';

interface Props {
  title?: string;
  description?: string;
  /** Classes of the page wrapper div; null renders header/main/footer directly in #root (as /om-stefan did). */
  wrapperClass?: string | null;
  /** Dark text header on white background (used by /bestilling). */
  lightHeader?: boolean;
  /** Bare page without header/footer (404). */
  bare?: boolean;
}
const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION, wrapperClass = 'min-h-screen bg-background', lightHeader = false, bare = false } = Astro.props;
const site = Astro.site!;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(path, site).href;
const ogImage = new URL('/images/og/social-preview.webp', site).href;
const isHome = path === '/';
---
<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Stefan Borup" />
    <meta name="robots" content="index, follow" />
    {!bare && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {!bare && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Original compiled Tailwind stylesheet from the old site, unchanged. -->
    <link rel="stylesheet" href="/assets/index-DBKj67Oc.css" />
    <slot name="head" />
  </head>
  <body>
    <div id="root">
      <Toaster />
      {bare ? <slot /> : wrapperClass === null ? (
        <Fragment>
          <Header light={lightHeader} isHome={isHome} />
          <slot />
          <Footer />
        </Fragment>
      ) : (
        <div class={wrapperClass}>
          <Header light={lightHeader} isHome={isHome} />
          <slot />
          <Footer />
        </div>
      )}
    </div>
  </body>
</html>
