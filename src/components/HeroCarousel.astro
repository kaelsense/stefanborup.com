---
import Icon from './Icon.astro';
interface Props { slides: { key: string; image: { src: string; alt: string } }[] }
const slides = Astro.props.slides.filter((s) => s.image?.src);
const SLIDE = 'absolute inset-0 transition-opacity duration-1000 ease-in-out';
const DOT_ON = 'h-2 rounded-full transition-all duration-300 bg-foreground w-8';
const DOT_OFF = 'h-2 rounded-full transition-all duration-300 w-2 bg-foreground/40 hover:bg-foreground/60';
---
{slides.length === 0 ? <section class="h-[60vh] w-full bg-dark-deeper"></section> : (
<section class="relative h-screen w-full overflow-hidden" aria-roledescription="karusell" data-hero data-slide-class={SLIDE} data-dot-on={DOT_ON} data-dot-off={DOT_OFF}>
  {slides.map((s, i) => (
    <div class={`${SLIDE} ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`} aria-hidden={i === 0 ? 'false' : 'true'} data-slide>
      <img src={s.image.src} alt={s.image.alt} decoding="async" loading={i === 0 ? 'eager' : 'lazy'} class="w-full h-full object-cover" />
    </div>
  ))}
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent z-20"></div>
  {slides.length > 1 && (
    <Fragment>
      <button class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-30 p-3 text-foreground/70 hover:text-foreground transition-colors" aria-label="Forrige bilde" data-prev><Icon name="chevron-left" size={40} strokeWidth={1} /></button>
      <button class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-30 p-3 text-foreground/70 hover:text-foreground transition-colors" aria-label="Neste bilde" data-next><Icon name="chevron-right" size={40} strokeWidth={1} /></button>
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex gap-3">
        {slides.map((_, i) => <button class={i === 0 ? DOT_ON : DOT_OFF} aria-label={`Gå til bilde ${i + 1}`} data-dot={i}></button>)}
      </div>
    </Fragment>
  )}
</section>
)}
<script>
  // Fades to the next slide every 6 s, as the original carousel did.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLElement>('[data-dot]')];
    const { slideClass, dotOn, dotOff } = hero.dataset;
    let current = 0;
    const show = (n: number) => {
      current = ((n % slides.length) + slides.length) % slides.length;
      slides.forEach((s, i) => { s.className = `${slideClass} ${i === current ? 'opacity-100 z-10' : 'opacity-0 z-0'}`; s.setAttribute('aria-hidden', String(i !== current)); });
      dots.forEach((d, i) => (d.className = i === current ? dotOn! : dotOff!));
    };
    hero.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    hero.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    if (slides.length > 1) setInterval(() => show(current + 1), 6000);
  }
</script>
