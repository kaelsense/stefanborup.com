{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.stefanborup.com" }],
      "destination": "https://stefanborup.com/:path",
      "permanent": true
    }
  ],
  "functions": {
    "api/lead.ts": { "maxDuration": 10 }
  }
}
